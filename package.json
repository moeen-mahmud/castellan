{
    "name": "dispach-monorepo",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "author": "Moeen Mahmud",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moeen-mahmud/dispach.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "bun run --filter='@dispach/core' build && bun run --filter='@dispach/tools-*' build && bun run --filter='@dispach/channel-*' build && bun run --filter='@dispach/server' build && bun run --filter='@dispach/cli' build && bun scripts/rewrite-dts-extensions.ts",
        "typecheck": "bun run --filter='*' typecheck",
        "test": "bun test",
        "test:node": "node --test packages/core/test/*.test.ts",
        "lint": "biome check .",
        "format": "biome format --write .",
        "check:deps": "bun scripts/check-deps.ts",
        "smoke:node": "node scripts/smoke-node.ts",
        "changeset": "changeset",
        "version:packages": "changeset version",
        "release": "changeset publish",
        "bench:boot": "bun scripts/bench-boot.ts",
        "eval:tools": "bun scripts/eval-tools.ts",
        "eval:injection": "bun scripts/eval-injection.ts",
        "eval:budget": "bun scripts/eval-budget.ts",
        "eval:phases": "bun scripts/eval-phases.ts",
        "mock": "bun scripts/mock-endpoint.ts",
        "verify:endpoints": "bun scripts/verify-endpoints.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.11",
        "@changesets/cli": "^2.29.8",
        "@types/bun": "^1.3.5",
        "typescript": "^5.9.3"
    }
}
