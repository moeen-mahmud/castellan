# Copy to `.env` beside the manifest. The real environment always wins over this file.
#
# This example is the deliberate exception: its manifest keeps ${MODEL_ID} and ${MODEL_BASE_URL}
# because its whole purpose is one manifest against four endpoints. A real agent — anything `init`
# generates — puts both in agent.yaml and keeps only secrets here.

# ── OpenAI ────────────────────────────────────────────────────────────────────────────────
MODEL_ID=gpt-5-6-sol
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=

# ── Anthropic, via its OpenAI-compatible endpoint ─────────────────────────────────────────
# MODEL_ID=claude-sonnet-5
# MODEL_BASE_URL=https://api.anthropic.com/v1
# MODEL_API_KEY=

# ── DeepSeek ──────────────────────────────────────────────────────────────────────────────
# MODEL_ID=deepseek-v4-pro
# MODEL_BASE_URL=https://api.deepseek.com/v1
# MODEL_API_KEY=

# ── Ollama, local ─────────────────────────────────────────────────────────────────────────
# MODEL_ID=qwen3.5:9b
# MODEL_BASE_URL=http://localhost:11434/v1
# # no key — delete apiKeyEnv from agent.yaml
