# Copy to `.env` beside the manifest and fill in the values. Never commit the copy.
#
# Only secrets belong here. The model id, the endpoint, the tools and the permissions are all
# in agent.yaml, where you can read them without opening a second file — which is also what
# stops another .env on the machine quietly changing which model this agent runs on.
#
# To point this agent somewhere else, edit `model.main.id` and `model.main.baseUrl` in the
# manifest, or ask the agent to: `config_set model.main.id`.

MODEL_API_KEY=

# ── Optional, only if the matching block in agent.yaml is uncommented ──────────────────────
# TAVILY_API_KEY=       # tools.providers.web with backend: tavily
# COMPOSIO_API_KEY=     # tools.providers.composio
